package com.example.tp;


// ======================================
// Classe Auteur
// ======================================
class Auteur {

    private static int compteur = 0;

    private final int id;
    private String nom;

    private Livre[] livres;
    private int nbLivres;

    // Constructeur
    public Auteur(String nom) {
        this.id = ++compteur;
        this.nom = nom;

        livres = new Livre[5];
        nbLivres = 0;
    }

    // Getters
    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    // Ajouter un livre
    public void ajouterLivre(Livre livre) {

        // Vérifier si le livre existe déjà
        for (int i = 0; i < nbLivres; i++) {
            if (livres[i] == livre) {
                return;
            }
        }

        // Agrandir le tableau si nécessaire
        if (nbLivres == livres.length) {

            Livre[] tmp = new Livre[livres.length * 2];

            System.arraycopy(
                    livres,
                    0,
                    tmp,
                    0,
                    livres.length
            );

            livres = tmp;
        }

        livres[nbLivres++] = livre;
    }

    // Afficher les livres
    public void afficherLivres() {

        for (int i = 0; i < nbLivres; i++) {
            System.out.println("  • " + livres[i]);
        }
    }

    // Nombre de livres
    public int getNbLivres() {
        return nbLivres;
    }

    // toString
    @Override
    public String toString() {
        return "Auteur[id=" + id
                + ", nom=" + nom
                + ", nbLivres=" + nbLivres
                + "]";
    }
}


// ======================================
// Classe Livre
// ======================================
class Livre {

    private static int compteur = 0;

    private final int id;
    private String titre;
    private Auteur auteur;

    // Constructeur
    public Livre(String titre, Auteur auteur) {

        this.id = ++compteur;
        this.titre = titre;
        this.auteur = auteur;

        // Association automatique
        auteur.ajouterLivre(this);
    }

    // Getters
    public int getId() {
        return id;
    }

    public String getTitre() {
        return titre;
    }

    public Auteur getAuteur() {
        return auteur;
    }

    // toString
    @Override
    public String toString() {

        return "Livre[id=" + id
                + ", titre=" + titre
                + ", auteur=" + auteur.getNom()
                + "]";
    }
}


