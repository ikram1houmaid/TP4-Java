// Classe Bibliotheque
// ======================================
class Bibliotheque {

    private static int compteur = 0;

    private final int id;
    private String nom;

    private Livre[] collection;
    private int nbLivres;

    // Constructeur
    public Bibliotheque(String nom) {

        this.id = ++compteur;
        this.nom = nom;

        collection = new Livre[5];
        nbLivres = 0;
    }

    // Getters
    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    // Ajouter un livre
    public void ajouterLivre(Livre livre) {

        // Vérifier les doublons
        for (int i = 0; i < nbLivres; i++) {
            if (collection[i] == livre) {
                return;
            }
        }

        // Agrandir le tableau si nécessaire
        if (nbLivres == collection.length) {

            Livre[] tmp = new Livre[collection.length * 2];

            System.arraycopy(
                    collection,
                    0,
                    tmp,
                    0,
                    collection.length
            );

            collection = tmp;
        }

        collection[nbLivres++] = livre;
    }

    // Afficher la collection
    public void afficherCollection() {

        for (int i = 0; i < nbLivres; i++) {

            Livre livre = collection[i];

            System.out.println(
                    "  – " +
                    livre.getTitre() +
                    " (id=" +
                    livre.getId() +
                    ")"
            );
        }
    }

    // toString
    @Override
    public String toString() {

        return "Bibliotheque[id=" + id
                + ", nom=" + nom
                + ", taille=" + nbLivres
                + "]";
    }
}


