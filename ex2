        );


        // Affichage Informatique
        System.out.println(info);
        info.afficherEtudiants();

        System.out.println();


        // Affichage Génie Civil
        System.out.println(genie);
        genie.afficherEtudiants();

        System.out.println();


        // Détail d'un étudiant
        System.out.println(
            "Détail de e3 : " + e3
        );
    }
}
