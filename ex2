package com.example.tp;

// =========================
// Classe Etudiant
// =========================
class Etudiant {

    private static int compteur = 0;
    private final int id;
    private String nom;
    private String prenom;
    private Filiere filiere;

    // Constructeur
    public Etudiant(String nom, String prenom) {
        this.id = ++compteur;
        this.nom = nom;
        this.prenom = prenom;
    }

    // Associer l'étudiant à une filière
    public void setFiliere(Filiere f) {
        this.filiere = f;
    }

    // Getters
    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    public String getPrenom() {
        return prenom;
    }

    public Filiere getFiliere() {
        return filiere;
    }

    // Affichage
    @Override
    public String toString() {
        String fil = (filiere != null) ? filiere.getNom() : "Aucune";

        return "Étudiant[id=" + id
                + ", nom=" + nom
                + ", prénom=" + prenom
                + ", filière=" + fil
                + "]";
    }
}


// =========================
// Classe Filiere
// =========================
class Filiere {

    private static int compteur = 0;
    private final int id;
    private String nom;
    private Etudiant[] etudiants;
    private int nbEtudiants;

    // Constructeur
    public Filiere(String nom) {
        this.id = ++compteur;
        this.nom = nom;
        this.etudiants = new Etudiant[5];
        this.nbEtudiants = 0;
    }

    // Getters
    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    public int getNbEtudiants() {
        return nbEtudiants;
    }

    // Ajouter un étudiant
    public void ajouterEtudiant(Etudiant e) {

        // Agrandir le tableau s'il est plein
        if (nbEtudiants == etudiants.length) {

            Etudiant[] tmp = new Etudiant[etudiants.length * 2];

            System.arraycopy(
                etudiants,
                0,
                tmp,
                0,
                etudiants.length
            );

            etudiants = tmp;
        }

        // Ajouter l'étudiant
        etudiants[nbEtudiants++] = e;

        // Créer l'association dans l'autre sens
        e.setFiliere(this);
    }

    // Afficher les étudiants
    public void afficherEtudiants() {

        System.out.println(
            "Filière " + nom +
            " (id=" + id + ") → " +
            nbEtudiants + " étudiants :"
        );

        for (int i = 0; i < nbEtudiants; i++) {

            System.out.println(
                "  • " +
                etudiants[i].getNom() + " " +
                etudiants[i].getPrenom() +
                " (id=" +
                etudiants[i].getId() +
                ")"
            );
        }
    }

    // Affichage de la filière
    @Override
    public String toString() {

        return "Filiere[id=" + id +
               ", nom=" + nom +
               ", nbEtudiants=" + nbEtudiants +
               "]";
    }
}


// =========================
// Classe Main
// =========================
public class Main {

    public static void main(String[] args) {

        // Création des filières
        Filiere info = new Filiere("Informatique");
        Filiere genie = new Filiere("Génie Civil");


        // Création des étudiants
        Etudiant e1 = new Etudiant("El Idrissi", "Mohamed");
        Etudiant e2 = new Etudiant("Bentaleb", "Fatima");
        Etudiant e3 = new Etudiant("Chouaib", "Youssef");
        Etudiant e4 = new Etudiant("Lahlou", "Salma");
        Etudiant e5 = new Etudiant("Roussafi", "Hassan");
        Etudiant e6 = new Etudiant("Amrani", "Aïcha");


        // Association avec Informatique
        info.ajouterEtudiant(e1);
        info.ajouterEtudiant(e2);
        info.ajouterEtudiant(e3);
        info.ajouterEtudiant(e4);
        info.ajouterEtudiant(e5);

        // 6ème étudiant :
        // le tableau passe de 5 à 10
        info.ajouterEtudiant(e6);


        // Association avec Génie Civil
        genie.ajouterEtudiant(
            new Etudiant("Belkahia", "Khadija")
        );

        genie.ajouterEtudiant(
